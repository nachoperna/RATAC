package views

templ ErrorCargaDiagnostico(titulo, contenido string) {
      <!-- Overlay de Error HTML -->
      <div id="error" class="error-overlay active" hx-swap-oob="true">
            <div class="error-content">
                  <div class="error-icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="12" y1="8" x2="12" y2="12"></line>
                              <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                  </div>
                  if titulo != "" {
                        <h3 class="error-title" id="error-title">{titulo}</h3>
                  } else {
                        <h3 class="error-title" id="error-title">Error en el archivo</h3>
                  }
                  if contenido != "" {
                        <p class="error-message" id="error-message">{contenido}</p>
                  } else {
                        <p class="error-message" id="error-message">Hubo un error en el proceso de carga. Inténtelo nuevamente.</p>
                  }
                  <div class="error-actions">
                        <button class="btn btn-primary" onclick="closeError()">Aceptar</button>
                  </div>
            </div>
            <script> procesado_exitoso = {false} </script>
      </div>
}

