package views

templ Login(next string, errMsg string) {
      <div class="container-login">
            <div class="login-card">
                  <div class="login-estado">Acceso</div>
                  <h2>Ingresar a RATAC</h2>
                  <p class="login-ayuda">Ingrese sus credenciales para acceder al sistema.</p>
                  @LoginFormulario(next, errMsg)
            </div>
      </div>
}

// LoginFormulario se renderiza solo ante un POST fallido, para reemplazar
// unicamente el formulario y mostrar el error sin recargar la pagina.
templ LoginFormulario(next string, errMsg string) {
      <form id="login-form" hx-post="/login" hx-target="#login-form" hx-swap="outerHTML">
            <input type="hidden" name="next" value={next}>

            if errMsg != "" {
                  <div class="login-error" role="alert">{errMsg}</div>
            }

            <label class="login-label" for="usuario">Usuario</label>
            <input class="login-input" type="text" id="usuario" name="usuario" autocomplete="username" required autofocus>

            <label class="login-label" for="password">Contraseña</label>
            <input class="login-input" type="password" id="password" name="password" autocomplete="current-password" required>

            <button class="btn-login" type="submit">Ingresar</button>
      </form>
}
