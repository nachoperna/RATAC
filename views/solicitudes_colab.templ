package views

import "RATAC/domain"

templ Solicitudes(solicitudes []domain.Solicitud) {
      if len(solicitudes) == 0 {
            @SinSolicitudes()
      } else {
            for _, solicitud := range solicitudes {
                  <article class="request-card">
                        <div class="request-header">
                              <div>
                                    <h3 class="lab-name">{solicitud.Nombre}</h3>
                                    <span class="lab-location">
                                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                          {solicitud.Ciudad}
                                    </span>
                                    <a href="mailto:contacto@diagvetintegral.com.ar" class="lab-location">
                                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                          {solicitud.Email}
                                    </a>
                              </div>
                              <span class="request-date">{solicitud.Fecha}</span>
                        </div>

                        <div class="vet-section">
                              <span class="vet-section-label">Veterinarios asociados</span>
                              <div class="vet-pills">
                                    for _, vet := range solicitud.Veterinarios {
                                          <span class="vet-pill">
                                                <span class="vet-name">{vet.Nombre}</span>
                                                <span class="vet-mat">{vet.Matricula}</span>
                                          </span>
                                    }
                              </div>
                        </div>
                        <div class="request-actions">
                              <button class="btn btn-outline"
                                    data-email_lab={ solicitud.Email }
                                    data-nombre_lab={ solicitud.Nombre }
                                    onclick="openRejectModal(this)"
                                    >Rechazar
                              </button>
                              <button 
                                    class="btn btn-primary"
                                    data-email_lab={ solicitud.Email }
                                    data-nombre_lab={ solicitud.Nombre }
                                    onclick="openAcceptModal(this)"
                                    >Aceptar
                              </button>
                        </div>
                  </article>
            }
            <!-- Paginación de Solicitudes -->
            <div class="requests-pagination">
                  <div class="page-buttons">
                        <button 
                              class="page-btn page-btn-text"
                              id="btn-anterior-solicitudes"
                              hx-get="/admin/solicitudes?desde_panel=true"
                              hx-vals='js:{offset: getOffsetRestandoSolicitudes()}'
                              hx-target="#requests-container"
                              hx-swap="innerHTML"
                              disabled>
                              Anterior
                        </button>
                        <button 
                              class="page-btn page-btn-text active"
                              hx-get="/admin/solicitudes?desde_panel=true"
                              hx-vals='js:{offset: getOffsetSolicitudes()}'
                              hx-target="#requests-container"
                              hx-swap="innerHTML"
                              hx-on::after-request="document.getElementById('btn-anterior-solicitudes').disabled = false;"
                              >
                              Siguiente
                        </button>
                  </div>
            </div>
      }
}

templ SinSolicitudes(){
      <div id="no-diagnoses-notice" class="no-data-notice">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div>
                  <p>No hay solicitudes por el momento</p>
            </div>
      </div>
}
