package views

templ ErrorTemplate(titulo, contenido string) {
      <!-- Overlay de Error HTML -->
      <div id="error" class="error-overlay active" hx-swap-oob="true" data-error="true">
            <div class="error-content">
                  <div class="error-icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="12" y1="8" x2="12" y2="12"></line>
                              <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                  </div>
                  if titulo != "" {
                        <h3 class="error-title" id="error-title">{titulo}</h3>
                  } else {
                        <h3 class="error-title" id="error-title">Error</h3>
                  }
                  if contenido != "" {
                        <p class="error-message" id="error-message">{contenido}</p>
                  } else {
                        <p class="error-message" id="error-message">Hubo un error en el proceso de su solicitud. Inténtelo nuevamente.</p>
                  }
                  <div class="error-actions">
                        <button class="btn btn-primary" onclick="closeError()">Aceptar</button>
                  </div>
            </div>
            <script>
                  function closeError() {
                        const el = document.getElementById('error');
                        el.classList.remove('active');
                        delete el.dataset.error;
                  };
            </script>
            <style>
                  #error.error-overlay {
                        --error-bg: #ffffff;
                        --error-border: #ddd8ee;
                        --error-navy: #1a1a6e;
                        --error-muted: #6b6b8a;
                        position: fixed;
                        top: 0; left: 0; right: 0; bottom: 0;
                        background: rgba(17, 17, 40, 0.4);
                        backdrop-filter: blur(4px);
                        z-index: 1000;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        opacity: 0;
                        pointer-events: none;
                        transition: opacity 0.3s ease;
                  }
                  #error.error-overlay.active {
                        opacity: 1;
                        pointer-events: auto;
                        animation: errorFadeIn .3s ease;
                  }
                  #error .error-content {
                        background: var(--error-bg);
                        border-radius: 12px;
                        padding: 32px 40px;
                        max-width: 400px;
                        width: 90%;
                        text-align: center;
                        box-shadow: 0 10px 40px rgba(26, 26, 110, 0.1);
                        transform: translateY(20px) scale(0.95);
                        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                        border: 1px solid var(--error-border);
                  }
                  #error.error-overlay.active .error-content {
                        animation: errorScaleIn .3s cubic-bezier(.175, .885, .32, 1.275);
                  }
                  #error .error-icon {
                        color: #d9534f;
                        margin-bottom: 16px;
                        display: flex;
                        justify-content: center;
                  }
                  #error .error-title {
                        font-family: 'Playfair Display', Georgia, serif;
                        font-size: 24px;
                        color: var(--error-navy);
                        margin-bottom: 12px;
                        font-weight: 500;
                  }
                  #error .error-message {
                        font-size: 15px;
                        color: var(--error-muted);
                        margin-bottom: 32px;
                        line-height: 1.5;
                  }
                  #error .error-actions .btn {
                        width: 100%;
                        font-family: 'DM Mono', monospace;
                        font-size: 12px;
                        letter-spacing: 0.05em;
                        text-transform: uppercase;
                        padding: 14px 24px;
                        border-radius: 6px;
                        cursor: pointer;
                        font-weight: 500;
                        border: none;
                        transition: all 0.2s;
                  }
                  #error .error-actions .btn-primary {
                        background-color: var(--error-navy);
                        color: #ffffff;
                        box-shadow: 0 4px 12px rgba(26, 26, 110, 0.2);
                  }
                  #error .error-actions .btn-primary:hover {
                        background-color: #2d2d8f;
                        transform: translateY(-2px);
                  }
                  @keyframes errorFadeIn  { from { opacity: 0 } to { opacity: 1 } }
                  @keyframes errorScaleIn { from { transform: translateY(20px) scale(.95) } to { transform: translateY(0) scale(1) } }
            </style>
      </div>
}

