package views

import "RATAC/domain"
import "fmt"
import "strconv"

func GetValue(campo *string) string{
      if campo != nil { return fmt.Sprint(*campo)}
      return "-"
}

templ ShowPaciente(paciente domain.Paciente, propietario bool) {
      <title id="ratac-title" hx-swap-oob="true">RATAC — {paciente.NombrePaciente}</title>

      <div class="container-paciente">
            <div class="card patient-card">
                  <div class="header-top">
                        <div class="badges">
                              <span class="badge">Protocolo: {paciente.Protocolo}</span>
                              <span class="badge date">{paciente.Fecha}</span>
                        </div>
                        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                              <a href={fmt.Sprintf("/diagnosticos/descarga/%s", paciente.Protocolo)} class="btn-edit-patient">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                          <polyline points="7 10 12 15 17 10"></polyline>
                                          <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                    <span>Descargar</span>
                              </a>
                              if propietario {
                                    <a href={ templ.SafeURL(fmt.Sprintf("/diagnosticos/editar/%s", paciente.Protocolo)) } class="btn-edit-patient">
                                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                          </svg>
                                          <span>Editar diagnóstico</span>
                                    </a>
                              }
                        </div>
                  </div>
 
                  <h1 class="patient-name">{paciente.NombrePaciente}</h1>

                  <!-- Grid Organizado de Categorías -->
                  <div class="info-grid">
                  <div class="info-item">
                        <span class="label">Especie</span>
                        <span class="value">{GetValue(paciente.Especie)}</span>
                  </div>
                  <div class="info-item">
                        <span class="label">Raza</span>
                        <span class="value">{GetValue(paciente.Raza)}</span>
                  </div>
                  <div class="info-item">
                        <span class="label">Edad</span>
                        if valor := GetValue(paciente.Edad); valor != "-" {
                              <span class="value">{valor} años</span>
                        } else {
                              <span class="value">{valor}</span>
                        }
                  </div>
                  <div class="info-item">
                        <span class="label">Solicitante</span>
                        <span class="value">{paciente.Solicitante}</span>
                  </div>
                  <div class="info-item">
                        <span class="label">Familia</span>
                        <span class="value">{GetValue(paciente.Familia)}</span>
                  </div>
                  <div class="info-item">
                        <span class="label">Técnica</span>
                        <span class="value">{paciente.Tecnica}</span>
                  </div>
                  </div>
            </div>

            <!-- =========================================
                  2. ANTECEDENTES
                  ========================================= -->
            <div class="section-header">
                  <div class="section-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  </div>
                  <h2 class="section-title">Material remitido - Antecedentes</h2>
            </div>
            
            <div class="card text-block">
                  {GetValue(paciente.Antecedentes)}
            </div>

            <!-- =========================================
                  3. DESCRIPCIÓN MACROSCÓPICA
                  ========================================= -->
            <div class="section-header">
                  <div class="section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                  </div>
                  <h2 class="section-title">Descripción Macroscópica</h2>
            </div>
            
            <div class="card text-block">
                  {GetValue(paciente.DescripcionMacroscopica)}
            </div>

            <!-- =========================================
                  4. DESCRIPCIÓN MICROSCÓPICA (Array)
                  ========================================= -->
            <div class="section-header">
                  <div class="section-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h4l2-9 5 18 3-9h6"></path></svg>
                  </div>
                  <h2 class="section-title">Análisis Microscópico y Diagnósticos</h2>
            </div>

            for index, desc_micro := range paciente.Descripciones_microscopicas {
                  <div class="card micro-card">
                        <div class="micro-content">
                              <h3 class="micro-organ">Descripción {index + 1}</h3>
                              <div class="micro-desc">
                                    {desc_micro.Descripcion}
                              </div>
                              if desc_micro.Diagnostico.Descripcion != nil {
                                    <div class="diagnosis-box">
                                          <div class="diagnosis-box-header">
                                                <span class="label">
                                                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                                      Diagnóstico
                                                </span>
                                                if desc_micro.Diagnostico.Grado != nil {
                                                      switch *desc_micro.Diagnostico.Grado{
                                                            case 1:
                                                                  <span class="grade-pill g1">
                                                                        <span class="pill-dot"></span>
                                                                        Grado 1
                                                                  </span>
                                                            case 2:
                                                                  <span class="grade-pill g2">
                                                                        <span class="pill-dot"></span>
                                                                        Grado 2
                                                                  </span>
                                                            case 3:
                                                                  <span class="grade-pill g3">
                                                                        <span class="pill-dot"></span>
                                                                        Grado 3
                                                                  </span>
                                                      }
                                                }
                                                if desc_micro.TablaGrado != nil {
                                                      <button type="button" class="btn-toggle-traits" data-traits-target="caracteristicas" onclick={toggleTable(templ.JSExpression("this"))}>
                                                            <span>Ver características</span>
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                                      </button>
                                                      <button type="button" class="btn-toggle-traits" data-traits-target="referencias" onclick={toggleTable(templ.JSExpression("this"))}>
                                                            <span>Ver referencias</span>
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                                      </button>
                                                }
                                          </div>
                                          <p>{*desc_micro.Diagnostico.Descripcion}</p>
                                          @TablaCaracteristicas(desc_micro.TablaGrado)
                                          @TablaMargenes()
                                    </div>
 
                              }else {
                                    <div class="diagnosis-box pending">
                                          <span class="label">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                                Pendiente
                                          </span>
                                          <p>Sin diagnóstico aún.</p>
                                    </div>
                              }
                        </div>
                        <span class="label">Imagenes Asociadas</span>
                        <div class="micro-images">
                              if len(desc_micro.Diagnostico.Imagenes) == 0 {
                                    <div class="no-images-text">
                                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                          No hay imágenes asociadas para esta descripción.
                                    </div>
                              } else {
                                    for _, imagen := range desc_micro.Diagnostico.Imagenes {
                                          <div class="micro-image">
                                                <img src={fmt.Sprintf("/%s", imagen)} alt={fmt.Sprintf("Imagen Diagnostico %d", index + 1)}
                                                      onclick="window.open(this.src, '_blank')">
                                          </div>
                                    }
                              }
                        </div>
                  </div>
            }
      </div>
}

templ TablaCaracteristicas(tabla []domain.Grado_oncologico){
      <!-- Tabla de Características desplegable -->
      <div class="traits-table-container" data-traits-table="caracteristicas">
            <table class="traits-table">
                  <thead>
                        <tr>
                              <th>Características</th>
                              <th>Muestra analizada</th>
                              <th class="score-header">Puntaje</th>
                        </tr>
                  </thead>
                  <tbody>
                        {{total := 0}}
                        for _, carac := range tabla {
                              {{p, _ := strconv.Atoi(carac.Puntaje)}}
                              {{total += p}}
                              <tr>
                                    <td class="italic-val">{carac.Caracteristica}</td>
                                    <td class="italic-val">{carac.Muestra_analizada}</td>
                                    <td class="score-cell">{carac.Puntaje}</td>
                              </tr>
                        }
                              <tr class="total-row">
                                    <td colspan="2" class="total-label">total</td>
                                    <td class="score-cell">{total}</td>
                              </tr>
                  </tbody>
            </table>
      </div>
}

templ TablaMargenes(){
      <!-- Tabla de Características desplegable -->
      <div class="traits-table-container" data-traits-table="referencias">
            <table class="traits-table">
                  <thead>
                        <tr>
                              <th colspan="2">Referencia márgenes (Stromberg y Meuten, 2017)</th>
                        </tr>
                  </thead>
                  <tbody>
                        <tr>
                              <td class="score-cell">M1</td>
                              <td class="italic-val">margen infiltrado focal o difuso</td>
                        </tr>
                        <tr>
                              <td class="score-cell">M2</td>
                              <td class="italic-val">margen cercano, menor a 2 mm</td>
                        </tr>
                        <tr>
                              <td class="score-cell">M3</td>
                              <td class="italic-val">margen limpio, 2 a 5 mm</td>
                        </tr>
                        <tr>
                              <td class="score-cell">M4</td>
                              <td class="italic-val">margen limpio mayor a 5 mm</td>
                        </tr>
                  </tbody>
            </table>
      </div>
}

script toggleTable(btn templ.JSExpression) {
      const box = btn.closest('.diagnosis-box');
      if (!box) return;

      const target = btn.dataset.traitsTarget;
      const tables = [...box.querySelectorAll('.traits-table-container')];
      const selected = tables.find(t => t.dataset.traitsTable === target);
      if (!selected) return;

      const willOpen = !selected.classList.contains('open');

      tables.forEach(t => t.classList.toggle('open', willOpen && t === selected));
      box.querySelectorAll('.btn-toggle-traits').forEach(b => {
            b.classList.toggle('active', willOpen && b === btn);
      });
}
